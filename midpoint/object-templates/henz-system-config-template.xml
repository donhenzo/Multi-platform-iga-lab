    <mapping>
        <name>Assign Role: IT - Systems Admin</name>
        <strength>strong</strength>
        <source>
            <path>$user/organizationalUnit</path>
        </source>
        <source>
            <path>$user/title</path>
        </source>
        <source>
            <path>$user/name</path>
        </source>
        <expression>
            <assignmentTargetSearch>
                <targetType>RoleType</targetType>
                <filter>
                    <q:equal>
                        <q:path>name</q:path>
                        <q:value>Role: IT - Systems Admin</q:value>
                    </q:equal>
                </filter>
            </assignmentTargetSearch>
        </expression>
        <condition>
            <script>
                <code>
                    def dept = basic.stringify(organizationalUnit)
                    def t = basic.stringify(title)
                    def eid = basic.stringify(name)
                    def pilotIds = ['H006','H007','H008','H011','H014','H019']
                    return dept == 'IT' &amp;&amp; t == 'Systems Administrator' &amp;&amp; pilotIds.contains(eid)
                </code>
            </script>
        </condition>
        <target>
            <path>assignment</path>
        </target>
    </mapping>

